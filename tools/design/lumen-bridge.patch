@@ -0,0 +1,60 @@
+/**
+ * Lumen bridge (added for the Lumen macOS app, not part of upstream OpenPencil).
+ *
+ * When the editor is opened inside Lumen's built-in browser as `/?lumen=<token>`, the same command
+ * handlers the MCP bridge uses are exposed on `window.lumenDesign`, so Lumen's agent can build and
+ * edit designs in the live editor the person sees. Files go through Lumen's local server (`/files/`).
+ */
+import { toJsonSchema } from '@valibot/to-json-schema'
+
+import { ALL_TOOLS, isToolExposed } from '@open-pencil/core/tools'
+
+import { makeFigmaFromStore } from '@/app/automation/bridge/figma-factory'
+import { createAutomationCommandHandlers } from '@/app/automation/bridge/handlers'
+import { automationFiles } from '@/app/automation/bridge/server'
+import SYSTEM_PROMPT from '@/app/ai/chat/system-prompt'
+import { getActiveStore } from '@/app/tabs'
+
+type LumenWindow = Window & {
+  lumenDesign?: unknown
+  webkit?: { messageHandlers?: Record<string, { postMessage: (body: unknown) => void } | undefined> }
+}
+
+const LUMEN_AGENT = { session: 'lumen-agent', kind: 'mcp' as const, client: 'Lumen' }
+
+export { isLumenEmbed } from '@/app/automation/bridge/embed'
+
+export function exposeLumenBridge() {
+  const token = new URLSearchParams(location.search).get('lumen')
+  if (!token) return
+  const w = window as LumenWindow
+  const { handleRequest } = createAutomationCommandHandlers(makeFigmaFromStore, automationFiles(location.origin, token))
+  const post = (body: unknown) => w.webkit?.messageHandlers?.lumenDesign?.postMessage(body)
+
+  w.lumenDesign = {
+    /** Any bridge command: tool, eval, export, selection, save_file, open_file, new_document, undo… */
+    call: (command: string, args: unknown) => handleRequest(getActiveStore(), command, args ?? {}),
+    /** One design tool by name, shown in the editor as Lumen's agent (cursor and outline). */
+    tool: (name: string, args: unknown, who?: string) =>
+      handleRequest(getActiveStore(), 'tool', {
+        name,
+        args: args ?? {},
+        agent: { ...LUMEN_AGENT, client: who || LUMEN_AGENT.client }
+      }),
+    /** Tool catalog for the agent: names, descriptions, JSON schemas of inputs. */
+    tools: () =>
+      ALL_TOOLS.filter((t) => isToolExposed(t, 'mcp')).map((t) => {
+        let schema: unknown = {}
+        try {
+          schema = toJsonSchema(t.input, { errorMode: 'ignore' })
+        } catch {
+          schema = {}
+        }
+        return { name: t.name, description: t.description, mutates: t.mutates, schema }
+      }),
+    /** How to author designs: the built-in assistant's guide and the JSX renderer reference. */
+    guide: () => SYSTEM_PROMPT,
+    ready: true
+  }
+  post({ type: 'ready' })
+}
