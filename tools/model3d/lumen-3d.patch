diff --git a/editor/js/Lumen.js b/editor/js/Lumen.js
new file mode 100644
index 0000000..450179e
--- /dev/null
+++ b/editor/js/Lumen.js
@@ -0,0 +1,377 @@
+/**
+ * Lumen bridge (added for the Lumen macOS app, not part of upstream three.js).
+ *
+ * When the editor is opened inside Lumen's built-in browser as `editor/?lumen=<token>`, `window.lumen3D`
+ * lets Lumen's agent build and change models in the live editor the person sees: run three.js code with
+ * undoable helpers, read the scene tree, render views to PNG, export GLB and save/load the project JSON.
+ */
+import * as THREE from 'three';
+import { GLTFExporter } from 'three/addons/exporters/GLTFExporter.js';
+import * as BufferGeometryUtils from 'three/addons/utils/BufferGeometryUtils.js';
+import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';
+import { ConvexGeometry } from 'three/addons/geometries/ConvexGeometry.js';
+
+import { AddObjectCommand } from './commands/AddObjectCommand.js';
+import { RemoveObjectCommand } from './commands/RemoveObjectCommand.js';
+import { MultiCmdsCommand } from './commands/MultiCmdsCommand.js';
+
+export function isLumen() {
+
+	return new URLSearchParams( location.search ).has( 'lumen' );
+
+}
+
+function round( v ) {
+
+	return Math.round( v * 1000 ) / 1000;
+
+}
+
+function vec( v ) {
+
+	return [ round( v.x ), round( v.y ), round( v.z ) ];
+
+}
+
+function describe( object, depth, maxDepth ) {
+
+	const node = { name: object.name || '', type: object.type, uuid: object.uuid };
+	if ( object !== object.parent ) {
+
+		node.position = vec( object.position );
+		const r = object.rotation;
+		if ( r.x || r.y || r.z ) node.rotation = vec( r );
+		const s = object.scale;
+		if ( s.x !== 1 || s.y !== 1 || s.z !== 1 ) node.scale = vec( s );
+
+	}
+
+	if ( object.isMesh ) {
+
+		node.geometry = object.geometry.type;
+		const p = object.geometry.parameters;
+		if ( p ) node.params = Object.fromEntries( Object.entries( p ).filter( ( [ , v ] ) => typeof v === 'number' ).map( ( [ k, v ] ) => [ k, round( v ) ] ) );
+		const m = Array.isArray( object.material ) ? object.material[ 0 ] : object.material;
+		if ( m ) {
+
+			node.material = m.type;
+			if ( m.color ) node.color = '#' + m.color.getHexString();
+			if ( m.roughness !== undefined ) node.roughness = round( m.roughness );
+			if ( m.metalness !== undefined && m.metalness ) node.metalness = round( m.metalness );
+			if ( m.transparent ) node.opacity = round( m.opacity );
+
+		}
+
+	}
+
+	if ( object.isLight ) {
+
+		node.intensity = round( object.intensity );
+		node.color = '#' + object.color.getHexString();
+
+	}
+
+	if ( object.children.length ) {
+
+		if ( depth >= maxDepth ) node.children = object.children.length;
+		else node.children = object.children.map( ( c ) => describe( c, depth + 1, maxDepth ) );
+
+	}
+
+	return node;
+
+}
+
+/** Geometries the project loader knows by type; others become plain BufferGeometry so a saved project always reopens */
+const REGISTERED = new Set( [ 'TextGeometry', 'RoundedBoxGeometry' ] );
+
+function portable( root ) {
+
+	root.traverse( ( o ) => {
+
+		if ( ! o.isMesh || ! o.geometry ) return;
+		const type = o.geometry.type;
+		if ( type === 'BufferGeometry' || REGISTERED.has( type ) || ( THREE[ type ] && THREE[ type ].prototype && THREE[ type ].prototype.isBufferGeometry ) ) return;
+		const plain = new THREE.BufferGeometry().copy( o.geometry );
+		plain.name = o.geometry.name;
+		o.geometry = plain;
+
+	} );
+
+}
+
+export function exposeLumen3D( editor ) {
+
+	THREE.ObjectLoader.registerGeometry( 'RoundedBoxGeometry', RoundedBoxGeometry );
+
+	if ( ! isLumen() ) return;
+
+	const scene = editor.scene;
+	// agent code may change objects directly (not through commands): count those runs too, so Lumen saves them
+	let directEdits = 0;
+
+	function find( nameOrUuid ) {
+
+		if ( ! nameOrUuid ) return null;
+		if ( typeof nameOrUuid === 'object' ) return nameOrUuid;
+		return scene.getObjectByProperty( 'uuid', nameOrUuid ) || scene.getObjectByName( nameOrUuid );
+
+	}
+
+	// every change goes through editor commands: the person can undo the agent's steps with ⌘Z
+	const pending = [];
+
+	function add( object, parent ) {
+
+		pending.push( new AddObjectCommand( editor, object, find( parent ) || undefined ) );
+		return object;
+
+	}
+
+	function remove( nameOrUuid ) {
+
+		const o = find( nameOrUuid );
+		if ( o && o !== scene ) pending.push( new RemoveObjectCommand( editor, o ) );
+		return !! o;
+
+	}
+
+	function flush( label ) {
+
+		if ( pending.length === 0 ) return;
+		const cmds = pending.splice( 0 );
+		if ( cmds.length === 1 ) editor.execute( cmds[ 0 ] );
+		else {
+
+			const multi = new MultiCmdsCommand( editor, cmds );
+			multi.name = label || 'Lumen';
+			editor.execute( multi );
+
+		}
+
+	}
+
+	function bounds( object ) {
+
+		const box = new THREE.Box3().setFromObject( object || scene );
+		if ( box.isEmpty() ) box.set( new THREE.Vector3( - 1, - 1, - 1 ), new THREE.Vector3( 1, 1, 1 ) );
+		return box;
+
+	}
+
+	/** Basic light so a fresh scene is not black; only if the scene has no lights yet */
+	function ensureLights() {
+
+		let has = false;
+		scene.traverse( ( o ) => { if ( o.isLight ) has = true; } );
+		if ( has ) return false;
+		const hemi = new THREE.HemisphereLight( 0xffffff, 0x444444, 2 );
+		hemi.name = 'Свет неба';
+		hemi.position.set( 0, 10, 0 );
+		const sun = new THREE.DirectionalLight( 0xffffff, 2.5 );
+		sun.name = 'Солнце';
+		sun.position.set( 5, 10, 7 );
+		add( hemi );
+		add( sun );
+		return true;
+
+	}
+
+	let shotRenderer = null;
+
+	function render( { view = 'iso', width = 1024, height = 768, target } = {} ) {
+
+		if ( ! shotRenderer ) {
+
+			shotRenderer = new THREE.WebGLRenderer( { antialias: true, preserveDrawingBuffer: true } );
+			shotRenderer.toneMapping = THREE.ACESFilmicToneMapping;
+			shotRenderer.outputColorSpace = THREE.SRGBColorSpace;
+
+		}
+
+		shotRenderer.setPixelRatio( 1 );
+		shotRenderer.setSize( width, height, false );
+		const subject = find( target );
+		let camera;
+		if ( view === 'current' ) {
+
+			camera = editor.viewportCamera.clone();
+			if ( camera.isPerspectiveCamera ) { camera.aspect = width / height; camera.updateProjectionMatrix(); }
+
+		} else {
+
+			const box = bounds( subject );
+			const center = box.getCenter( new THREE.Vector3() );
+			// the whole bounding sphere fits the narrower side of the frame, with a margin
+			const radius = ( box.getSize( new THREE.Vector3() ).length() / 2 ) || 1;
+			const fov = 35;
+			const vHalf = THREE.MathUtils.degToRad( fov / 2 );
+			const hHalf = Math.atan( Math.tan( vHalf ) * ( width / height ) );
+			const distance = radius / Math.sin( Math.min( vHalf, hHalf ) ) * 1.12;
+			camera = new THREE.PerspectiveCamera( fov, width / height, distance / 100, distance * 100 );
+			const dirs = { front: [ 0, 0, 1 ], back: [ 0, 0, - 1 ], left: [ - 1, 0, 0 ], right: [ 1, 0, 0 ], top: [ 0, 1, 0.0001 ], iso: [ 1, 0.8, 1.2 ] };
+			const d = new THREE.Vector3( ...( dirs[ view ] || dirs.iso ) ).normalize();
+			camera.position.copy( center ).addScaledVector( d, distance );
+			camera.lookAt( center );
+
+		}
+
+		// the selected object alone: hide everything else that is not a light
+		const hidden = [];
+		if ( subject ) {
+
+			scene.traverse( ( o ) => {
+
+				if ( o === scene || o.isLight ) return;
+				let inside = false;
+				for ( let p = o; p; p = p.parent ) if ( p === subject ) inside = true;
+				let ancestor = false;
+				for ( let p = subject; p; p = p.parent ) if ( p === o ) ancestor = true;
+				if ( ! inside && ! ancestor && o.visible ) { hidden.push( o ); o.visible = false; }
+
+			} );
+
+		}
+
+		const bg = scene.background;
+		if ( ! bg ) scene.background = new THREE.Color( 0x2b2b2b );
+		shotRenderer.render( scene, camera );
+		scene.background = bg;
+		hidden.forEach( ( o ) => { o.visible = true; } );
+		return shotRenderer.domElement.toDataURL( 'image/png' ).split( ',' )[ 1 ];
+
+	}
+
+	window.lumen3D = {
+
+		ready: true,
+
+		/** Scene tree; depth limits how deep children go */
+		tree( depth = 6 ) {
+
+			const box = bounds();
+			return {
+				scene: describe( scene, 0, depth ),
+				selected: editor.selected ? editor.selected.uuid : null,
+				bounds: { min: vec( box.min ), max: vec( box.max ) }
+			};
+
+		},
+
+		/**
+		 * Runs agent code. Inside: THREE, scene, editor, add(object, parent?), remove(nameOrUuid), find(nameOrUuid),
+		 * select(nameOrUuid), lights(), utils (BufferGeometryUtils), RoundedBoxGeometry, ConvexGeometry and
+		 * `await import('three/addons/…')` for anything else. All adds and removes become one undo step.
+		 */
+		async run( code ) {
+
+			const AsyncFunction = Object.getPrototypeOf( async function () {} ).constructor;
+			const fn = new AsyncFunction( 'THREE', 'scene', 'editor', 'add', 'remove', 'find', 'select', 'lights', 'utils', 'RoundedBoxGeometry', 'ConvexGeometry', code );
+			let result;
+			try {
+
+				result = await fn( THREE, scene, editor, add, remove, find, ( n ) => editor.select( find( n ) ), ensureLights, BufferGeometryUtils, RoundedBoxGeometry, ConvexGeometry );
+				for ( const c of pending ) if ( c.object ) portable( c.object );
+				portable( scene );
+				flush( 'Lumen' );
+				directEdits ++;
+
+			} catch ( e ) {
+
+				pending.splice( 0 );
+				throw e;
+
+			}
+
+			editor.signals.sceneGraphChanged.dispatch();
+			editor.signals.objectChanged.dispatch( editor.selected || scene );
+			if ( result === undefined ) return null;
+			try { return JSON.parse( JSON.stringify( result, ( k, v ) => ( v && v.isObject3D ) ? { name: v.name, uuid: v.uuid, type: v.type } : v ) ); } catch ( e ) { return String( result ); }
+
+		},
+
+		/** PNG (base64) of the scene or of one object, from a view: iso, front, back, left, right, top, current */
+		shot( options ) {
+
+			return render( options || {} );
+
+		},
+
+		/** What the person selected, with a picture of it alone */
+		selection() {
+
+			const o = editor.selected;
+			if ( ! o ) return null;
+			return { name: o.name || '', type: o.type, uuid: o.uuid, info: describe( o, 0, 2 ), image: render( { view: 'iso', width: 800, height: 600, target: o } ) };
+
+		},
+
+		select( nameOrUuid ) {
+
+			const o = find( nameOrUuid );
+			editor.select( o );
+			if ( o ) editor.focus( o );
+			return !! o;
+
+		},
+
+		focus() {
+
+			editor.focus( editor.selected || scene );
+
+		},
+
+		/** Editable project (scene, camera, history) — reopened with load() */
+		project() {
+
+			return JSON.stringify( editor.toJSON() );
+
+		},
+
+		async load( json, name ) {
+
+			editor.clear();
+			if ( json ) await editor.fromJSON( typeof json === 'string' ? JSON.parse( json ) : json );
+			if ( name ) editor.scene.name = name;
+			editor.signals.sceneGraphChanged.dispatch();
+			return true;
+
+		},
+
+		async fresh( name ) {
+
+			editor.clear();
+			editor.scene.name = name || 'Сцена';
+			ensureLights();
+			flush( 'Свет' );
+			editor.signals.sceneGraphChanged.dispatch();
+			return true;
+
+		},
+
+		/** GLB (base64) of the whole scene or one object — opens in Blender, macOS Quick Look, game engines */
+		async glb( target ) {
+
+			const exporter = new GLTFExporter();
+			const subject = find( target ) || scene;
+			const result = await exporter.parseAsync( subject, { binary: true, onlyVisible: true } );
+			const bytes = new Uint8Array( result );
+			let s = '';
+			for ( let i = 0; i < bytes.length; i += 0x8000 ) s += String.fromCharCode.apply( null, bytes.subarray( i, i + 0x8000 ) );
+			return btoa( s );
+
+		},
+
+		/** Undo history length — Lumen saves only when something changed */
+		changes() {
+
+			return editor.history.undos.length + editor.history.redos.length * 1000 + directEdits * 1000000;
+
+		}
+
+	};
+
+	// Lumen's own window shows names in Russian; the editor follows the browser language
+	window.webkit?.messageHandlers?.lumen3D?.postMessage( { type: 'ready' } );
+
+}
